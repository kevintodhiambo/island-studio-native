<Window x:Class="IslandNative.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island Dock"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" SizeToContent="Manual"
        Width="1100" Height="120"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
    <Grid>
        <Border x:Name="Bar" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#B81F1F24" CornerRadius="22" Padding="12,8" Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="7" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <StackPanel x:Name="Items" Orientation="Horizontal"/>
        </Border>
    </Grid>
</Window>
