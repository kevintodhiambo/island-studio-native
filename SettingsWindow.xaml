<Window x:Class="IslandNative.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island Studio"
        Width="460" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#1A1A1E" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="42" Height="24" CornerRadius="12" Background="#3A3A42">
                            <Ellipse x:Name="thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#32D74B"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A92"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,18,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#26262C"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,4"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F0F3"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7E7E86"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <StackPanel>
            <!-- header -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,2">
                <Border Width="34" Height="34" CornerRadius="9" Background="#0B0B0D" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="White" Margin="2,0"/>
                        <Ellipse Width="5" Height="5" Fill="White" Margin="2,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Island Studio" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="A living notch for Windows" Foreground="#8A8A92" FontSize="11.5"/>
                </StackPanel>
            </StackPanel>

            <!-- General -->
            <TextBlock Text="GENERAL" Style="{StaticResource Head}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,12">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="Open Island Studio when you sign in." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="TgStartup" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="#33000000" Opacity="0.4"/>
                    <Grid Margin="0,12">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Idle eyes" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="Show the eyes when nothing is happening." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="TgEyes" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="#33000000" Opacity="0.4"/>
                    <Grid Margin="0,12">
                        <StackPanel HorizontalAlignment="Left" MaxWidth="330">
                            <TextBlock Text="Minimal notch" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="At rest, shrink to a thin line. Good for thick-bezel laptops. Hover to open it as usual." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="TgMinimal" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Dock -->
            <TextBlock Text="DOCK" Style="{StaticResource Head}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,12">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Show the dock" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="A dock of your apps along the bottom." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="TgDock" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="#33000000" Opacity="0.4"/>
                    <Grid Margin="0,12">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Magnify on hover" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="Icons grow as the cursor passes." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="TgMagnify" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="#33000000" Opacity="0.4"/>
                    <StackPanel Margin="0,12">
                        <TextBlock Text="Icon size" Style="{StaticResource RowLabel}"/>
                        <Grid Margin="0,8,0,0">
                            <Slider x:Name="SlDockSize" Minimum="32" Maximum="64" IsMoveToPointEnabled="True"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="ABOUT" Style="{StaticResource Head}"/>
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="AboutVersion" Foreground="#F0F0F3" FontSize="13"/>
                    <TextBlock Text="Built by SkyLogic IT Solutions" Foreground="#8A8A92" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
