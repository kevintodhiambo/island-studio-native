<Window x:Class="IslandNative.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install Island Studio"
        Width="440" Height="330" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#1A1A1E" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="#32D74B">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3BE557"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#2E2E34"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#8A8A92"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#C8C8D0"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="26,22,26,20">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border Width="44" Height="44" CornerRadius="11" Background="#0B0B0D" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="White" Margin="3,0"/>
                        <Ellipse Width="7" Height="7" Fill="White" Margin="3,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Install Island Studio" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubText" Text="A living notch for Windows" Foreground="#8A8A92" FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="0,18,0,0" Foreground="#C8C8D0" FontSize="13" TextWrapping="Wrap"
                       Text="This installs one clean copy and closes any copies that are already running, so you never end up with duplicates."/>
            <TextBlock x:Name="DestText" Margin="0,10,0,0" Foreground="#6E6E76" FontSize="11.5" TextWrapping="Wrap"/>

            <CheckBox x:Name="CbStartup" Margin="0,16,0,0" IsChecked="True" Foreground="#F0F0F3" FontSize="13"
                      Content="Start Island Studio when I sign in"/>

            <Button x:Name="BtnInstall" Style="{StaticResource Primary}" Margin="0,20,0,0" Content="Install"/>
            <TextBlock x:Name="Status" Margin="0,10,0,0" Foreground="#8A8A92" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button x:Name="BtnRunOnce" Style="{StaticResource Link}" Margin="0,8,0,0" Content="Just run it once, without installing"/>
        </StackPanel>
    </Grid>
</Window>
