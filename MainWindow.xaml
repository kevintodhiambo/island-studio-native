<Window x:Class="IslandNative.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island Studio"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" SizeToContent="Manual"
        Width="640" Height="220"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Round, flat icon button used for media transport -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="#F2F2F4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Thin slider for the control center -->
        <Style x:Key="CcSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16" VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate><Border Height="4" CornerRadius="2" Background="#F2F2F4" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate><Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Focusable="False">
                                        <Thumb.Template><ControlTemplate><Ellipse Fill="White"><Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4" Color="Black"/></Ellipse.Effect></Ellipse></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="Notch" VerticalAlignment="Top" HorizontalAlignment="Center" Width="230" Height="38">
            <Path x:Name="NotchBg" Fill="#0B0B0D"/>

            <!-- ===== COMPACT: clock + battery ===== -->
            <StackPanel x:Name="CompactClock" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="CTime" Foreground="White" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel x:Name="CBatt" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Grid Width="25" Height="12" VerticalAlignment="Center">
                        <Border BorderBrush="#AFAFB4" BorderThickness="1.3" CornerRadius="3"/>
                        <Border x:Name="CBattFill" Background="#AFAFB4" CornerRadius="1.5" HorizontalAlignment="Left" Margin="2" Width="16"/>
                        <Path x:Name="CBoltIcon" Width="9" Height="11" Stretch="Uniform" Visibility="Collapsed" Fill="#FFD60A" Data="M13.5 2 5 13.5h6L10 22l9-12h-6.2z"/>
                    </Grid>
                    <Rectangle Width="2" Height="4" Fill="#AFAFB4" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Margin="1,0,0,0"/>
                    <Path x:Name="CPlugIcon" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed" Fill="#FF9F0A" VerticalAlignment="Center" Margin="6,0,0,0"
                          Data="M8 2 h2 v4 h-2 z M14 2 h2 v4 h-2 z M6 6 h12 v3.5 a6 6 0 0 1 -12 0 z M11 14 h2 v5 h-2 z"/>
                    <TextBlock x:Name="CBattPct" Foreground="#CFCFD4" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- ===== COMPACT: now playing (art + equalizer) ===== -->
            <Grid x:Name="CompactMedia" Visibility="Collapsed" Margin="14,0">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Border HorizontalAlignment="Left" Width="24" Height="24" CornerRadius="6" ClipToBounds="True" Background="#2A2A30">
                        <Image x:Name="CArt" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel x:Name="CEq" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="15">
                        <Rectangle x:Name="Eq0" Width="3" Height="5" Fill="#32D74B" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center"/>
                        <Rectangle x:Name="Eq1" Width="3" Height="9" Fill="#32D74B" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center"/>
                        <Rectangle x:Name="Eq2" Width="3" Height="6" Fill="#32D74B" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center"/>
                        <Rectangle x:Name="Eq3" Width="3" Height="11" Fill="#32D74B" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===== Idle eyes ===== -->
            <StackPanel x:Name="Eyes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform><TranslateTransform x:Name="EyesT"/></StackPanel.RenderTransform>
                <Ellipse x:Name="EyeL" Width="9" Height="9" Fill="White" Margin="6,0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="EyeLS"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="EyeR" Width="9" Height="9" Fill="White" Margin="6,0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="EyeRS"/></Ellipse.RenderTransform>
                </Ellipse>
            </StackPanel>

            <!-- ===== EXPANDED: media player ===== -->
            <Grid x:Name="ExpMedia" Opacity="0" Visibility="Collapsed">
                <!-- Player view -->
                <Grid x:Name="PlayerView" Margin="22,16,24,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="78" Height="78" CornerRadius="12" ClipToBounds="True" VerticalAlignment="Center">
                        <Grid>
                            <Border Background="#1C1C20"/>
                            <Image x:Name="MArt" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
                            <TextBlock x:Name="MTitle" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MArtist" Foreground="#9A9A9E" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid VerticalAlignment="Bottom" Margin="0,0,0,40" Height="4">
                            <Border Background="#33FFFFFF" CornerRadius="2"/>
                            <Border x:Name="MFill" Background="#F2F2F4" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <Button x:Name="BtnPrev" Style="{StaticResource IconBtn}" Content="&#xE892;"/>
                            <Button x:Name="BtnPlay" Style="{StaticResource IconBtn}" Content="&#xE768;" FontSize="18" Width="38" Height="38"/>
                            <Button x:Name="BtnNext" Style="{StaticResource IconBtn}" Content="&#xE893;"/>
                        </StackPanel>
                        <Button x:Name="BtnLyrics" Style="{StaticResource IconBtn}" Content="&#xE720;" Width="30" Height="30" FontSize="14"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="Lyrics" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
                <!-- Lyrics view -->
                <Grid x:Name="LyricsView" Margin="26,12,26,12" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="LyPrev" Foreground="#5E5E66" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Margin="0,0,0,5" TextTrimming="CharacterEllipsis" MaxHeight="20"/>
                        <TextBlock x:Name="LyCur" Foreground="White" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                        <TextBlock x:Name="LyNext" Foreground="#5E5E66" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxHeight="20"/>
                    </StackPanel>
                    <Button x:Name="BtnLyricsBack" Style="{StaticResource IconBtn}" Content="&#xE72B;" Width="28" Height="28" FontSize="13"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" ToolTip="Back to player"/>
                </Grid>
            </Grid>

            <!-- ===== EXPANDED: info (clock/date/battery) ===== -->
            <Grid x:Name="ExpInfo" Opacity="0" Visibility="Collapsed" Margin="26,16,24,16">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="ETime" Foreground="White" FontSize="42" FontWeight="SemiBold" LineHeight="44"/>
                    <TextBlock x:Name="EDate" Foreground="#9A9A9E" FontSize="13" Margin="2,4,0,0"/>
                    <TextBlock x:Name="WxText" Foreground="#B8B8BE" FontSize="12.5" Margin="2,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1E1E22" CornerRadius="9" Padding="10,4">
                    <TextBlock x:Name="EBatt" Foreground="#E6E6EA" FontSize="12.5" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- ===== EXPANDED: control center (volume + brightness) ===== -->
            <Grid x:Name="ExpCC" Opacity="0" Visibility="Collapsed" Margin="24,20,24,18">
                <StackPanel VerticalAlignment="Center">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VolIcon" Grid.Column="0" Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#E6E6EA" VerticalAlignment="Center" Width="22" TextAlignment="Center" Cursor="Hand"/>
                        <Slider x:Name="SlVol" Grid.Column="1" Style="{StaticResource CcSlider}" Margin="12,0"/>
                        <TextBlock x:Name="VolPct" Grid.Column="2" Foreground="#9A9A9E" FontSize="12" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="BriRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#E6E6EA" VerticalAlignment="Center" Width="22" TextAlignment="Center"/>
                        <Slider x:Name="SlBri" Grid.Column="1" Style="{StaticResource CcSlider}" Margin="12,0"/>
                        <TextBlock x:Name="BriPct" Grid.Column="2" Foreground="#9A9A9E" FontSize="12" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- page dots -->
            <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" Opacity="0"/>
        </Grid>
    </Grid>
</Window>
