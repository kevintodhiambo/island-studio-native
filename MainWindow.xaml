<Window x:Class="IslandNative.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IslandNative"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" SizeToContent="Manual"
        Width="620" Height="190"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid>
        <!-- The notch, drawn as a single filled Path: flush top, concave "shoulders" that
             flare into the screen edge, rounded bottom. One piece = no seam, no white strip. -->
        <Grid x:Name="Notch" VerticalAlignment="Top" HorizontalAlignment="Center" Width="230" Height="38">
            <Path x:Name="NotchBg" Fill="#0B0B0D"/>

            <!-- Compact standby: centered time + battery -->
            <StackPanel x:Name="Compact" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="CTime" Foreground="White" FontSize="14.5" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel x:Name="CBatt" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Grid Width="25" Height="12" VerticalAlignment="Center">
                        <Border BorderBrush="#AFAFB4" BorderThickness="1.3" CornerRadius="3"/>
                        <Border x:Name="CBattFill" Background="#AFAFB4" CornerRadius="1.5"
                                HorizontalAlignment="Left" Margin="2" Width="16"/>
                        <Path x:Name="CBoltIcon" Width="9" Height="11" Stretch="Uniform" Visibility="Collapsed"
                              Fill="#FFD60A" Data="M13.5 2 5 13.5h6L10 22l9-12h-6.2z"/>
                    </Grid>
                    <Rectangle Width="2" Height="4" Fill="#AFAFB4" RadiusX="1" RadiusY="1"
                               VerticalAlignment="Center" Margin="1,0,0,0"/>
                    <Path x:Name="CPlugIcon" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"
                          Fill="#FF9F0A" VerticalAlignment="Center" Margin="6,0,0,0"
                          Data="M8 2 h2 v4 h-2 z M14 2 h2 v4 h-2 z M6 6 h12 v3.5 a6 6 0 0 1 -12 0 z M11 14 h2 v5 h-2 z"/>
                    <TextBlock x:Name="CBattPct" Foreground="#CFCFD4" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Idle eyes -->
            <StackPanel x:Name="Eyes" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform><TranslateTransform x:Name="EyesT"/></StackPanel.RenderTransform>
                <Ellipse x:Name="EyeL" Width="7" Height="7" Fill="White" Margin="5,0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="EyeLS"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="EyeR" Width="7" Height="7" Fill="White" Margin="5,0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="EyeRS"/></Ellipse.RenderTransform>
                </Ellipse>
            </StackPanel>

            <!-- Expanded content -->
            <Grid x:Name="Expanded" Opacity="0" Margin="26,16,24,16">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="ETime" Foreground="White" FontSize="42" FontWeight="SemiBold" LineHeight="44"/>
                    <TextBlock x:Name="EDate" Foreground="#9A9A9E" FontSize="13" Margin="2,4,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1E1E22"
                        CornerRadius="9" Padding="10,4">
                    <TextBlock x:Name="EBatt" Foreground="#E6E6EA" FontSize="12.5" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
